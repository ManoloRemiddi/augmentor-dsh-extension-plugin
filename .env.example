# Copied to augmentor/.env by whoever runs Augmentor. The bridge merges this into
# the runtime's environment (existing env wins).
#
# The local llama.cpp server needs no auth by default, so this file can be
# empty. If you point the runtime elsewhere:
# DSH_LLM_BASE_URL=http://127.0.0.1:8080/v1
#
# If that endpoint requires an API key, also add `apiKeyEnv: <VAR>` to the
# local-qwen route in deepseek-harness/examples/jsonrpc-agent/augmentor.cordis.yml
# and set it here:
# DSH_LLM_KEY=sk-...
